# ============================================================================
# ForgeGuard Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure your local settings.
# NEVER commit real API keys or secrets to version control.

# ----------------------------------------------------------------------------
# LLM Provider & Model Selection
# ----------------------------------------------------------------------------
# Provider: 'groq' for live model inference, 'mock' for deterministic offline mock.
# When FORGEGUARD_PROVIDER=groq is set, GROQ_API_KEY is required.
# Default if unspecified: 'groq' if GROQ_API_KEY is present, else 'mock'.
FORGEGUARD_PROVIDER=groq

# Groq API Key (Required when FORGEGUARD_PROVIDER=groq)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Model Selection
# Default: qwen/qwen3.8-27b
# Supported Groq models include:
#   - qwen/qwen3.8-27b (recommended default)
#   - llama-3.3-70b-versatile
#   - llama-3.1-8b-instant
#   - mixtral-8x7b-32768
FORGEGUARD_DEFAULT_MODEL=qwen/qwen3.8-27b
# Legacy alias for backward compatibility:
# GROQ_MODEL=qwen/qwen3.8-27b

# ----------------------------------------------------------------------------
# Runtime Server Configuration
# ----------------------------------------------------------------------------
# FORGEGUARD_HOST=127.0.0.1
# FORGEGUARD_PORT=8000
# FORGEGUARD_DB_PATH=forgeguard.db
# FORGEGUARD_WORKSPACE_ROOT=workspaces

# ----------------------------------------------------------------------------
# API Security & Authentication
# ----------------------------------------------------------------------------
# Set an API key to require X-API-Key / Bearer auth for API endpoints:
# FORGEGUARD_API_KEY=fg_dev_secret_key_12345
# Set to 'true' to allow unauthenticated loopback access during development:
# FORGEGUARD_AUTH_DISABLED=true
